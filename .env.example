# LoopOS env vars — copy to .env and fill in (or use op run --env-file)

# TokenRouter (LLM gateway). OpenAI-compatible.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=

# Runpod (Whisper transcription, off-stage path).
RUNPOD_API_KEY=
RUNPOD_WHISPER_URL=

# Reboot dev port (defaults).
RBT_VITE_PORT=4444
